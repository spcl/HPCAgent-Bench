# extends: layers/model-qwen38.env
AGENT_EFFORT=xhigh
VLLM_EXTRA_ARGS="--dtype auto --load-format safetensors --safetensors-load-strategy prefetch --generation-config auto --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3 --max-model-len 262144 --gpu-memory-utilization 0.70 --max-num-seqs 128 --language-model-only"
AGENT_TIMEOUT_SECONDS=28800
LANGUAGE=c

# mem-fraction-static and --attention-backend aiter are ONE decision: aiter multiplies the
# value by 0.85 internally. sglang then splits ONE budget, mamba = R*r/(1+r) and KV = R/(1+r)
# with r = --mamba-full-memory-ratio; this pair gives a 3.32M-token KV pool and 704 slots.
# The pool must exceed the working set or the prefix cache stops retaining: see
# docs/serving/qwen38.md. Read the slot count from the allocator, never from the ratio.
SGLANG_EXTRA_ARGS="--chat-template ${SCRIPT_DIR}/chat-template-qwen38.jinja --trust-remote-code --attention-backend aiter --language-only --watchdog-timeout 1800 --context-length 262144 --mem-fraction-static 0.306 --mamba-full-memory-ratio 0.5 --max-running-requests 128 --enable-metrics --reasoning-parser qwen3 --tool-call-parser qwen3_coder --enable-cache-report"
API_TIMEOUT_MS=3600000
