# extends: layers/model-qwen38.env

# The rungs THIS server accepts, lowest first; the launcher resolves AGENT_EFFORT from them
# (experiments/effort.py). Not low/medium/high/xhigh: the chat template raises on anything
# outside low/medium/xhigh, and only reaches xhigh under its own name or the alias max.
EFFORT_LADDER="low medium xhigh"

# The served context window (--context-length / --max-model-len below), so every harness sizes
# its own prompt budget off the same number the engine was started with.
CONTEXT_LENGTH=262144

# wall clock + total-token budgets, paired as the source of truth for the driver's cap and prompt
AGENT_TIMEOUT_SECONDS=14400
LANGUAGE=c

# mem-fraction-static + --attention-backend aiter is ONE decision (aiter scales it x0.85 internally).
# sglang splits that budget mamba=R*r/(1+r) KV=R/(1+r), r=--mamba-full-memory-ratio; read the slot
# count from the allocator, see docs/serving/qwen38.md.
# r 0.5 -> 0.25 at the same --mem-fraction-static 0.306: KV pool 3.36M -> 4.03M tokens, which is
# what carries 40 streams over the prefix-cache threshold (3.36M did not).
SGLANG_EXTRA_ARGS="--chat-template ${SCRIPT_DIR}/chat-template-qwen38.jinja --trust-remote-code --attention-backend aiter --language-only --watchdog-timeout 1800 --context-length 262144 --mem-fraction-static 0.306 --mamba-full-memory-ratio 0.25 --max-running-requests 128 --enable-metrics --reasoning-parser qwen3 --tool-call-parser qwen3_coder --enable-cache-report"
