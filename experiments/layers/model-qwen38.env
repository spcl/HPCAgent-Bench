# Qwen3.8-27B (FP8) on one node: vLLM with aiter attention, 1.77x SGLang's best line at 40 agents
# (docs/serving/qwen38.md).
# extends: replicas.env
INFERENCE_CE_ENV=hpcagent-bench-vllm-mi300-latest
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
HPCAGENT_BENCH_OPTIMIZER=Qwen/Qwen3.8-27B-FP8
VLLM_ROCM_USE_AITER=1
# quoted: sourced under `set -a`, so word-splitting on spaces would run a stray command
VLLM_EXTRA_ARGS="--dtype auto --attention-backend ROCM_AITER_FA --chat-template ${HPCAGENT_BENCH_REPO}/containers/inference/chat-template-qwen38.jinja --trust-remote-code --max-model-len 262144 --gpu-memory-utilization 0.70 --max-num-seqs 128 --language-model-only --enable-prefix-caching --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3"
