# qwen38 serving on one mi200 node: BF16
# (MI250X has no FP8), tp8 at --mem-fraction-static 0.80 -> KV 1.91M tokens, 128 running requests,
# ~322 tok/s. aiter has no gfx90a kernels: triton attention, SGLANG_USE_AITER=0. Chat template and
# the qwen3 reasoning / qwen3_coder tool parsers are the mi300 arms' own (campaign:qwen38).
INFERENCE_CE_ENV=hpcagent-bench-sglang-mi200-latest
VLLM_MODEL=Qwen/Qwen3.8-27B
HPCAGENT_BENCH_OPTIMIZER=Qwen/Qwen3.8-27B
SGLANG_USE_AITER=0
SGLANG_ATTENTION_BACKEND=triton
SGLANG_EXTRA_ARGS="--chat-template ${SCRIPT_DIR}/chat-template-qwen38.jinja --trust-remote-code --disable-custom-all-reduce --language-only --watchdog-timeout 1800 --context-length 262144 --mem-fraction-static 0.80 --max-running-requests 128 --enable-metrics --reasoning-parser qwen3 --tool-call-parser qwen3_coder --enable-cache-report"
