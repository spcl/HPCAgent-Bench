# qwen38 serving on one mi200 node: BF16 (MI250X has no FP8) on the AMD vLLM image, tp8 over the
# node's 8 GCDs (partition-mi200.env GPUS_PER_NODE). 16 concurrent 256-token requests run at about
# 420 tok/s aggregate. Chat template and the qwen3 reasoning / qwen3_coder tool parsers are the
# mi300 arms' own (campaign:qwen38).
INFERENCE_ENGINE=vllm
INFERENCE_CE_ENV=hpcagent-bench-vllm-mi200-latest
VLLM_MODEL=Qwen/Qwen3.8-27B
HPCAGENT_BENCH_OPTIMIZER=Qwen/Qwen3.8-27B
# quoted: sourced under `set -a`, so word-splitting on spaces would run a stray command
VLLM_EXTRA_ARGS="--dtype bfloat16 --chat-template ${HPCAGENT_BENCH_REPO}/containers/inference/chat-template-qwen38.jinja --trust-remote-code --max-model-len 262144 --gpu-memory-utilization 0.85 --max-num-seqs 128 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3"
