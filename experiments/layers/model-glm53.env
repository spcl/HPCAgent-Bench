# GLM-5.3 (fp8), sglang tp4 x pp4. Its serving args and AGENTS_PER_NODE=12 live in arms.yaml
# (glm53-serving): the fortran arms run a different pair.
# extends: pp.env
# the only sglang EDF that loads GLM-5.3 (the format_ue8m0 patch)
INFERENCE_CE_ENV=sglang-candidate
VLLM_MODEL=zai-org/GLM-5.3
# slowest PP stage (up to 5400 s) + KV alloc + graph capture
VLLM_ENGINE_READY_TIMEOUT_S=10800
AGENT_READY_TIMEOUT_SECONDS=10800
HPCAGENT_BENCH_OPTIMIZER=zai-org/GLM-5.3
# ASSIGNED EMPTY, not absent: run_cluster.sh reads ${VAR-aiter}, so only an empty value omits
# --attention-backend and GlmMoeDsaForCausalLM picks dsa
SGLANG_ATTENTION_BACKEND=
