# glm53 serving config shared by .env.base-glm53 and every .env.llrbase-glm53-*.
# The counterfactual of the kimi27sglang arms: only the serving block and AGENTS_PER_NODE differ.
# Every deviation from the kimi line is load-bearing:
#   SGLANG_ATTENTION_BACKEND=    ASSIGNED EMPTY, not absent: run_cluster.sh reads ${VAR-aiter}, so
#                                only an assigned empty value omits --attention-backend.
#   --language-only              absent: selects the VLM receiver role, which refuses this model.
#   --enable-hierarchical-cache  absent: offloads KV to host memory, the SAME pool on MI300A.
#   AITER_USE_FLYDSL_MOE_SORTING absent: kimi's weights are pack-quantized int4; these are fp8.
#   AGENTS_PER_NODE=12           kimi's 20 ran GLM-5.3's PP stages out of host memory (636501).
#   *_READY_TIMEOUT*=10800       slowest PP stage (up to 5400 s) + KV alloc + graph capture.
# extends: common.env
INFERENCE_NODES=4
INFERENCE_MODE=pp

# pinned off the alternate MORI build: its package install can overwrite an aiter patch this MLA
# path needs
# sglang-candidate is the only sglang EDF that can load GLM-5.3: the others reach the same
# format_ue8m0 patch via a $SCRATCH PYTHONPATH that role_mounts drops for the inference role
INFERENCE_CE_ENV=sglang-candidate
VLLM_MODEL=zai-org/GLM-5.3
VLLM_SERVED_MODEL=hpcagent-bench-vllm
VLLM_PORT=8000
VLLM_MASTER_PORT=29500
VLLM_ENGINE_READY_TIMEOUT_S=10800
VLLM_DISTRIBUTED_TIMEOUT_SECONDS=7200

# these three toggles stay 0: this arm serves via sglang, and enabling any hangs the RCCL/ROCm build
VLLM_DISTRIBUTED_USE_SPLIT_GROUP=0
VLLM_EAGER_PG_PATCH=0
VLLM_EAGER_PG_DEVICE_ID=0

# RCCL auto-enables GDR unless disabled: on this fabric GDR silently corrupts cross-node sums
NCCL_NET_GDR_LEVEL=0
VLLM_EXTRA_ARGS=
VLLM_API_KEY=EMPTY
AGENT_READY_TIMEOUT_SECONDS=10800
CLAUDE_MODEL=hpcagent-bench-llm
HPCAGENT_BENCH_OPTIMIZER=zai-org/GLM-5.3
CLAUDE_AUTOCOMPACT=200144
LITELLM_PORT=4000
LITELLM_MASTER_KEY=EMPTY
THROUGHPUT_PROBE_REQUESTS=3
AGENT_START_STAGGER_SECONDS=60
AGENT_START_STAGGER_MAX_SECONDS=300
AGENT_TIMEOUT_SECONDS=28800
INFERENCE_ENGINE=sglang
SGLANG_PYTHON=/opt/venv/bin/python3
SGLANG_USE_AITER=1
SGLANG_ROCM_FUSED_DECODE_MLA=0
SGLANG_SET_CPU_AFFINITY=0
AITER_LOG_TUNED_CONFIG=1

# --- GLM-5.3 deviations from the kimi arm this env was derived from ---
# mem-fraction-static is a CEILING on weights+KV: pool(f) = 39.0M * (f - 0.4838) tokens at tp4 x
# pp4. The pool is PINNED at 2.8M by --max-total-tokens under f0.57, with --chunked-prefill-size 4096
# and --max-running-requests 48 bounding the prefill ratchet and req_to_token: host memory, not the
# pool, is what kills a PP stage. Frontier 633828 leg G2 served conc 40 with no error, peak 485 GiB of
# the 501 GiB step cgroup; plain f0.55 was OOM-killed on a PP node at conc 20 in 635349.
# SGLANG_ATTENTION_BACKEND is EMPTY so no flag reaches the server and GlmMoeDsaForCausalLM picks
# dsa; an explicit aiter would suppress that and also scale mem-fraction-static by 0.85.
# No --language-only: it selects the VLM receiver role, off this architecture's allowlist.
# GLM-5.3-Flash cannot run here: index_kpool forces CUDA-only IndexerKPool; 5.3 uses ROCm DSA.
SGLANG_ATTENTION_BACKEND=
