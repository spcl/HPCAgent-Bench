# Every group below is output of a tool, never source. tests/test_ignore_rules.py pins one
# representative path per group, and that no tracked file matches a rule.

# --- Python bytecode, packaging and build trees (pip, build, setuptools, helpers/scripts/do_release.sh) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.installed.cfg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
pip-wheel-metadata/
__pypackages__/
/develop-eggs/
/downloads/
/eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
/target/
/instance/

# --- Virtual environments and local interpreter pins ---
.venv
venv/
ENV/
/env/
env.bak/
venv.bak/
.python-version

# --- Test, lint and type-check caches (pytest, ruff, mypy, pyre, hypothesis, tox, nox, coverage) ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
*.cover
*.py,cover
coverage.xml
htmlcov/
nosetests.xml
.cache/
# CI replay of the MPI/grading-seal collection step (.github/workflows/tests.yml).
/collected.txt
# OpenBLAS built by CI and the login-node test replay ($HPCAGENT_BENCH_BLAS_CACHE).
/.openblas-cache/

# --- Other Python tooling left behind by editors and frameworks ---
.ipynb_checkpoints
profile_default/
ipython_config.py
.ropeproject
.spyderproject
.spyproject
.scrapy
.webassets-cache
celerybeat-schedule
celerybeat.pid
*.sage.py
*.mo
*.pot
*.log
# The harness logs of the recorded episodes the transcript extract is tested against.
!tests/fixtures/transcripts/**/*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/site
docs/_build/

# --- Repo-root .scratch/ (HPCAGENT_BENCH_SCRATCH's default): logs, core dumps and native-mode submissions ---
/.scratch/*
!/.scratch/.gitkeep

# --- Repo-root .cache/: only its README is source (per-kernel .cache/ dirs are covered above) ---
!/.cache/
/.cache/*
!/.cache/README.md

# --- DaCe build folders, SDFG dumps and viewers ---
.dacecache/
*.dacecache/
.dacecache_rank*/
_dacegraphs/
*.sdfg
sdfg.sdfg

# --- Package-local caches: sparse generators, GT4Py, compiled Fortran modules ---
.hpcagent_bench_cache/
.gt_cache/
*.mod

# --- Framework siblings emitted from <kernel>_numpy.py (framework loaders, helpers/scripts/emit_all_siblings.py) ---
# Deterministic, so only the numpy reference, manifest and hand overrides are committed. A hand
# override at one of these names gets a `!` line in the last group of this file. TVM and Triton
# have no translator, so their committed hand siblings are not matched here.
hpcagent_bench/benchmarks/**/*_dace.py
hpcagent_bench/benchmarks/**/*_cupy.py
hpcagent_bench/benchmarks/**/*_numba.py
hpcagent_bench/benchmarks/**/*_pythran.py
hpcagent_bench/benchmarks/**/*_jax.py
hpcagent_bench/benchmarks/**/*_auto.py
hpcagent_bench/benchmarks/**/*_cpp.py

# --- Native siblings, Pluto/PPCG output and their builds, all under a kernel's cpp_backend/ ---
hpcagent_bench/benchmarks/**/cpp_backend/*.c
hpcagent_bench/benchmarks/**/cpp_backend/*.cpp
hpcagent_bench/benchmarks/**/cpp_backend/*.f90
hpcagent_bench/benchmarks/**/cpp_backend/*_binding.json
hpcagent_bench/benchmarks/**/cpp_backend/*.so
hpcagent_bench/benchmarks/**/cpp_backend/*.cu
hpcagent_bench/benchmarks/**/cpp_backend/*.hip
hpcagent_bench/benchmarks/**/cpp_backend/*.build
hpcagent_bench/benchmarks/**/cpp_backend/*.hu
hpcagent_bench/benchmarks/**/cpp_backend/build/
hpcagent_bench/benchmarks/**/cpp_backend/build-clang/
# hpcagent_bench.ppcg_transform's scratch dir, left behind when a transform is killed.
hpcagent_bench/benchmarks/**/cpp_backend/.ppcg_transform_*/
*.pluto.cloog

# --- Run outputs: results DB and shards, figures, native-mode submissions, compiler reports ---
# The .gitkeep files keep each root present in a fresh clone.
results/*
!results/.gitkeep
!results/plots/
results/plots/*
!results/plots/.gitkeep
# Every SQLite database (results, shards, canon) is data, never source; the fixtures tests read are the exception.
*.db
*.db-*
!tests/data/*.db
*.csv
!tests/data/llr40/data/*.csv
/opt_reports/
# Documented default outputs of `hf export`, `harbor generate/run` and `grade-under worklist/run`.
hf_dataset/
harbor-runs/
adapters/hpcagent_bench/tasks/
adapters/hpcagent_bench/runs/
/tasks/
/worklist.jsonl
/regrades/

# --- Job output and crash dumps that land wherever sbatch was run ---
slurm-*.out
/*.out
/*.err
/*.txt
core_*
core.[0-9]*
!core_*.py
/containers/**/logs/
scratchpad/

# --- Container images and staged copies (squashfs exports, materialize_shared.sh, image contexts) ---
*.sqsh
/agent/skills/
/containers/**/staged-skills/
/shared/
/vendor/

# --- Machine-local config and secrets: never committed ---
.env
hpcagent_bench/harness/hidden_tests/secret_seeds.json
.claude/
!tests/fixtures/transcripts/**/.claude/
helpers/scripts/cscs/env.toml
*.pem
*.key
*_key
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
.ssh/
*.p12
*.pfx

# --- Local-only notes, drafts and scratch ---
/paper/
HANDOFF_ISSUES/
BACKLOG*.md
dmidecode_output
agent_out/
_session_scratch/
*.ritom-orig
helpers/scripts/infer_output_args.py
helpers/scripts/verify_tvm.py
tools/pluto_affine_survey_results.txt

# --- Hand overrides at generated names (hpcagent_bench/benchmarks/) are committed with `git add -f`; the
# regenerator leaves a file without its autogen marker alone, and git keeps a tracked file tracked.
experiments/mwd-final-*/

# anonymous.4open.science replacement terms (identifying, never committed)
.anonymize-terms.txt

# Polygeist lowering artifacts a pluto build writes next to the reference
*_pluto_input_polygeist_*
