# HPCAgent-Bench C / C++ formatting. A neutral base (LLVM) with the repo-wide 120-column
# limit (matching [tool.ruff] in pyproject.toml for Python and .fprettify.rc for Fortran). Enforced
# on changed files by the CI `format-check` job (scripts/checks/check_format.py).
BasedOnStyle: LLVM
ColumnLimit: 120
