diff --git a/hpcagent_bench/translators/numpyto_common/ast_names.py b/hpcagent_bench/translators/numpyto_common/ast_names.py
new file mode 100644
index 0000000..0e9a83e
--- /dev/null
+++ b/hpcagent_bench/translators/numpyto_common/ast_names.py
@@ -0,0 +1,82 @@
+"""Name-level AST helpers every pass shares: rename, substitute, and the name / block censuses."""
+
+import ast
+import copy
+from collections.abc import Mapping
+
+from hpcagent_bench.translators.numpyto_common.ordered import OrderedSet
+
+__all__ = [
+    "RenameNames",
+    "SubstituteNames",
+    "assigned_names",
+    "constants",
+    "loaded_names",
+    "statement_lists",
+]
+
+
+class RenameNames(ast.NodeTransformer):
+    """Rename each ``Name`` in ``mapping`` in place -- loads and stores alike -- and, with ``args``,
+    each parameter too."""
+
+    def __init__(self, mapping: Mapping[str, str], args: bool = False) -> None:
+        self.mapping = mapping
+        self.args = args
+
+    def visit_Name(self, node: ast.Name) -> ast.Name:
+        node.id = self.mapping.get(node.id, node.id)
+        return node
+
+    def visit_arg(self, node: ast.arg) -> ast.arg:
+        if self.args:
+            node.arg = self.mapping.get(node.arg, node.arg)
+        return node
+
+
+class SubstituteNames(ast.NodeTransformer):
+    """Replace each ``Name`` in ``mapping`` with a fresh copy of its expression; only reads unless
+    ``loads_only`` is off."""
+
+    def __init__(self, mapping: Mapping[str, ast.expr], loads_only: bool = True) -> None:
+        self.mapping = mapping
+        self.loads_only = loads_only
+
+    def visit_Name(self, node: ast.Name) -> ast.AST:
+        if self.loads_only and not isinstance(node.ctx, ast.Load):
+            return node
+        replacement = self.mapping.get(node.id)
+        return node if replacement is None else ast.copy_location(copy.deepcopy(replacement), node)
+
+
+def constants(values: Mapping[str, object]) -> dict[str, ast.expr]:
+    """``{name: Constant(value)}`` -- a :class:`SubstituteNames` mapping that folds names to literals."""
+    return {name: ast.Constant(value=value) for name, value in values.items()}
+
+
+def loaded_names(node: ast.AST) -> set[str]:
+    """Every name READ in the subtree."""
+    return {n.id for n in ast.walk(node) if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load)}
+
+
+def assigned_names(tree: ast.AST) -> OrderedSet[str]:
+    """The bare names the subtree assigns or augments (``x = ...`` / ``x += ...``)."""
+    names: OrderedSet[str] = OrderedSet()
+    for n in ast.walk(tree):
+        if isinstance(n, ast.Assign):
+            names.update(t.id for t in n.targets if isinstance(t, ast.Name))
+        elif isinstance(n, ast.AugAssign) and isinstance(n.target, ast.Name):
+            names.add(n.target.id)
+    return names
+
+
+def statement_lists(root: ast.AST) -> list[list[ast.stmt]]:
+    """Every non-empty statement list in the subtree: bodies, else branches and finally blocks."""
+    blocks: list[list[ast.stmt]] = []
+    for node in ast.walk(root):
+        # An ast node keeps its fields in ``__dict__``, and most node types carry none of these.
+        for field in ("body", "orelse", "finalbody"):
+            block = vars(node).get(field)
+            if isinstance(block, list) and block and isinstance(block[0], ast.stmt):
+                blocks.append(block)
+    return blocks
