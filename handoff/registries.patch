+dace_flavor(
+    "dace_gpu_canonicalize",
+    pipeline="canon_gpu",
+    transform="canonicalize",
+    codegen="readable",
+    arch="gpu",
+    full_name="DaCe GPU canonicalize",
+    label="DaCe (GPU, canonicalized)",
+    hue=24,
+    column="dace_gpu",
+    flavor="canonicalize",
+    tags=("canon", "canon-llr40", "canon-figure"),
