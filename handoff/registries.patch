diff --git a/tests/test_framework_registry.py b/tests/test_framework_registry.py
new file mode 100644
index 0000000..104cfed
--- /dev/null
+++ b/tests/test_framework_registry.py
@@ -0,0 +1,87 @@
+# Copyright 2021 ETH Zurich and the HPCAgent-Bench authors.
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""The registries hold their own invariants: every framework registration is complete, and every
+list derived from it (canon columns, autopar probes, auto-gen targets, dace pipelines) is a view."""
+
+import pathlib
+import subprocess
+import sys
+
+import pytest
+
+from hpcagent_bench import autogen, flags
+from hpcagent_bench.frameworks import dace_flavors
+from hpcagent_bench.frameworks.flavors import FRAMEWORK_META, framework_aliases, hue_order, tagged
+from hpcagent_bench.harness import preflight
+from hpcagent_bench.registry import Registry
+
+DACE_FRAMEWORK = pathlib.Path(dace_flavors.__file__).with_name("dace_framework.py")
+
+
+def test_every_framework_has_a_label_and_its_own_hue() -> None:
+    """Hues are colour slots, handed out append-only: 0..N-1, one flavor each."""
+    assert all(meta["label"] for meta in FRAMEWORK_META.values())
+    assert sorted(meta["hue"] for meta in FRAMEWORK_META.values()) == list(range(len(FRAMEWORK_META)))
+    assert set(hue_order()) == set(FRAMEWORK_META)
+
+
+def test_an_alias_never_shadows_a_registered_framework() -> None:
+    aliases = framework_aliases()
+    assert not set(aliases) & set(FRAMEWORK_META)
+    assert set(aliases.values()) <= set(FRAMEWORK_META)
+
+
+def test_the_canon_column_sets_nest() -> None:
+    """The figure and the llr40 sweep draw from the canon board's columns, never outside them."""
+    canon = set(tagged("canon"))
+    assert set(tagged("canon-figure")) <= set(tagged("canon-llr40")) <= canon
+    assert set(tagged("canon-polyhedral")) <= canon
+
+
+def test_every_autogen_target_has_an_emitter() -> None:
+    wanted = {target for meta in FRAMEWORK_META.values() for target in meta["autogen"]}
+    assert wanted == set(autogen.TARGETS)
+
+
+def test_every_autopar_probe_is_a_flags_function() -> None:
+    for name, meta in FRAMEWORK_META.items():
+        if "autopar_probe" in meta:
+            assert callable(getattr(flags, meta["autopar_probe"])), name
+            assert preflight.AUTOPAR_PROBES[name] is getattr(flags, meta["autopar_probe"])
+
+
+def test_every_dace_pipeline_is_scored_by_one_flavor_and_names_a_transform() -> None:
+    source = DACE_FRAMEWORK.read_text(encoding="utf-8")
+    scored = [p for meta in FRAMEWORK_META.values() if meta["base"] == "dace" for p in meta.get("pipelines", ())]
+    assert sorted(scored) == sorted(dace_flavors.PIPELINE_SPECS)
+    for spec in dace_flavors.PIPELINE_SPECS.values():
+        assert f"\ndef pipeline_{spec.transform}(" in source, spec
+        assert spec.codegen in ("classic", "readable"), spec
+
+
+def test_the_metadata_imports_without_a_backend() -> None:
+    """The registry is read by figure scripts and submitters: it must never pull dace/jax in."""
+    code = "import sys, hpcagent_bench.frameworks.flavors; print(sorted({'dace', 'jax'} & set(sys.modules)))"
+    proc = subprocess.run([sys.executable, "-c", code], capture_output=True, text=True, check=True)
+    assert proc.stdout.strip() == "[]"
+
+
+def test_a_registry_refuses_a_second_owner_and_hints_a_close_name() -> None:
+    registry: Registry[int] = Registry("widget")
+    registry.register("alpha", 1, origin="a")
+    registry.register("alpha", 2, origin="a")  # a reload of the same module
+    assert registry["alpha"] == 2
+    with pytest.raises(ValueError, match="already registered by a"):
+        registry.register("alpha", 3, origin="b")
+    with pytest.raises(KeyError, match="did you mean 'alpha'"):
+        registry["alpah"]
+
+
+def test_the_decorator_form_registers_what_it_decorates() -> None:
+    registry: Registry[object] = Registry("widget")
+
+    @registry.register("thing")
+    def thing() -> None:
+        return None
+
+    assert registry.names() == ("thing",) and registry["thing"] is thing
