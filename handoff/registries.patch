+# Copyright 2021 ETH Zurich and the HPCAgent-Bench authors.
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Native C/C++/Fortran: one flavor per (language, compiler[, flags preset]), each building its own .so.
+
+``compiler`` names a ``compilers.yaml`` block and ``flags`` a :mod:`hpcagent_bench.flags` preset;
+``polly`` is the C++ clang flavor with the polyhedral preset. An autopar column names the probe
+that must confirm it parallelizes (``autopar_probe``); one without a probe is not gated.
+"""
+
+from hpcagent_bench.frameworks.flavors import IEEE_PRECISIONS, FrameworkMeta, framework
+
+
+def native(
+    name: str,
+    *,
+    language: str,
+    compiler: str,
+    full_name: str,
+    label: str,
+    hue: int,
+    flags: str | None = None,
+    sweep_deterministic: bool = False,
+    autopar_probe: str | None = None,
+    tags: tuple[str, ...] = (),
+    aliases: tuple[str, ...] = (),
+) -> FrameworkMeta:
+    """Register one native CPU flavor."""
+    return framework(
+        name,
+        base="native",
+        postfix="cpp",
+        arch="cpu",
+        precisions=IEEE_PRECISIONS,
+        language=language,
+        compiler=compiler,
+        flags=flags,
+        full_name=full_name,
+        label=label,
+        hue=hue,
+        sweep_deterministic=sweep_deterministic,
+        autopar_probe=autopar_probe,
+        tags=tags,
+        aliases=aliases,
+    )
+
+
+# The C family across the four graded vendors. ``cc_<vendor>`` rather than the bare vendor name because
+# ``llvm`` and ``polly`` already mean the C++ clang columns. There is deliberately no
+# ``cc_oneapi_autopar``: icx has no auto-parallelizer (``-parallel`` is accepted with warning #10430
+# and outlines nothing), so the arm would publish serial numbers under a parallel name.
+native(
+    "cc",
+    language="c",
+    compiler="gcc",
+    full_name="C (gcc)",
+    label="GCC",
+    hue=2,
+    sweep_deterministic=True,
+    tags=("canon", "canon-llr40", "canon-figure"),
+    aliases=("c",),
+)
+native(
+    "cc_autopar",
+    language="c",
+    compiler="gcc",
+    flags="cc_autopar",
+    full_name="C autopar (gcc)",
+    label="GCC (autopar)",
+    hue=7,
+    sweep_deterministic=True,
+    autopar_probe="gcc_autopar_capability",
+    tags=("canon", "canon-llr40", "canon-figure"),
+    # The judge stamps a graded row's denominator in its own spelling.
+    aliases=("c-autopar",),
+)
+native("cc_llvm", language="c", compiler="clang", full_name="C (clang)", label="Clang", hue=15)
+native(
+    "cc_llvm_autopar",
+    language="c",
+    compiler="clang",
+    flags="cc_llvm_autopar",
+    full_name="C Polly (clang)",
+    label="Clang (autopar)",
+    hue=16,
+)
+native("cc_oneapi", language="c", compiler="icx", full_name="C (icx)", label="oneAPI", hue=19)
+native("cc_nvhpc", language="c", compiler="nvc", full_name="C (nvc)", label="NVHPC", hue=17)
+native(
+    "cc_nvhpc_autopar",
+    language="c",
+    compiler="nvc",
+    flags="cc_nvhpc_autopar",
+    full_name="C autopar (nvc)",
+    label="NVHPC (autopar)",
+    hue=18,
+)
+native(
+    "llvm", language="cpp", compiler="clang", full_name="C++ (clang)", label="Clang", hue=10, sweep_deterministic=True
+)
+# The gcc half of C++, so a C-vs-C++ comparison stays within one compiler family.
+native(
+    "cpp",
+    language="cpp",
+    compiler="gpp",
+    full_name="C++ (g++)",
+    label="g++",
+    hue=5,
+    sweep_deterministic=True,
+    tags=("canon",),
+)
+native(
+    "fortran",
+    language="fortran",
+    compiler="gfortran",
+    full_name="Fortran (gfortran)",
+    label="gfortran",
+    hue=4,
+    sweep_deterministic=True,
+    tags=("canon",),
+)
+native(
+    "fortran_autopar",
+    language="fortran",
+    compiler="gfortran",
+    flags="fortran_autopar",
+    full_name="Fortran autopar (gfortran)",
+    label="gfortran (autopar)",
+    hue=21,
+    sweep_deterministic=True,
+    autopar_probe="gcc_autopar_capability",
+    tags=("canon",),
+)
+# LLVM Fortran (declines cleanly if the driver is absent).
+native(
+    "flang",
+    language="fortran",
+    compiler="flang",
+    full_name="Fortran (flang)",
+    label="Flang",
+    hue=20,
+    sweep_deterministic=True,
+)
+native(
+    "polly",
+    language="cpp",
+    compiler="clang",
+    flags="polly",
+    full_name="C++ Polly (clang)",
+    label="Polly",
+    hue=12,
+    sweep_deterministic=True,
+    autopar_probe="polly_capability",
+)
