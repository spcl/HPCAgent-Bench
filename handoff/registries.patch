new file mode 100644
index 0000000..ae9e497
--- /dev/null
+++ b/hpcagent_bench/registry.py
@@ -0,0 +1,88 @@
+# Copyright 2021 ETH Zurich and the HPCAgent-Bench authors.
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""A named, ordered registry: the one shape every plugin axis (frameworks, distributions ...) uses.
+
+Standard library only, so a registry of cheap metadata never pulls a backend in. Entries keep
+registration order; registering a taken name is an error unless the same module registers it again
+(a reload).
+"""
+
+import difflib
+import importlib
+import pkgutil
+import sys
+from collections.abc import Callable, Iterator, Mapping
+from typing import TypeVar, overload
+
+T = TypeVar("T")
+
+
+class Registry(Mapping[str, T]):
+    """``name -> T`` in registration order; a read-only :class:`~collections.abc.Mapping` whose
+    lookup of an unknown name raises a ``KeyError`` naming the closest registered spellings."""
+
+    def __init__(self, kind: str) -> None:
+        self.kind = kind
+        self.entries: dict[str, T] = {}
+        self.origins: dict[str, str] = {}
+
+    @overload
+    def register(self, name: str) -> Callable[[T], T]: ...
+
+    @overload
+    def register(self, name: str, value: T, origin: str = "") -> T: ...
+
+    def register(self, name: str, *args: T, origin: str = "") -> T | Callable[[T], T]:
+        """``register(name, value)`` registers ``value``; ``@register(name)`` registers what it
+        decorates. ``origin`` is the registering module (default: the caller's, or the decorated
+        object's ``__module__``)."""
+        if args:
+            return self.add(name, args[0], origin or caller_module(1))
+
+        def decorate(value: T) -> T:
+            return self.add(name, value, str(getattr(value, "__module__", "")) or caller_module(1))
+
+        return decorate
+
+    def add(self, name: str, value: T, origin: str) -> T:
+        """Store ``value`` under ``name``; a second registration is refused unless ``origin`` matches."""
+        known = self.origins.get(name)
+        if known is not None and known != origin:
+            raise ValueError(f"{self.kind} {name!r} is already registered by {known}")
+        self.entries[name] = value
+        self.origins[name] = origin
+        return value
+
+    def __getitem__(self, name: str) -> T:
+        if name not in self.entries:
+            raise KeyError(self.unknown(name))
+        return self.entries[name]
+
+    def __iter__(self) -> Iterator[str]:
+        return iter(self.entries)
+
+    def __len__(self) -> int:
+        return len(self.entries)
+
+    def names(self) -> tuple[str, ...]:
+        """Every registered name, in registration order."""
+        return tuple(self.entries)
+
+    def unknown(self, name: str) -> str:
+        """The message for an unregistered ``name``: the closest spellings, then every known one."""
+        close = difflib.get_close_matches(name, list(self.entries), n=3)
+        hint = f" (did you mean {', '.join(map(repr, close))}?)" if close else ""
+        return f"unknown {self.kind} {name!r}{hint}; known: {sorted(self.entries)}"
+
+    def autoload(self, package: str, suffix: str = "") -> None:
+        """Import every module of ``package`` whose name ends in ``suffix``, so its registrations run."""
+        path = getattr(importlib.import_module(package), "__path__", ())
+        for info in pkgutil.iter_modules(path):
+            if info.name.endswith(suffix):
+                importlib.import_module(f"{package}.{info.name}")
+
+
+def caller_module(depth: int = 1) -> str:
+    """``__name__`` of the module ``depth`` frames above this function's caller."""
+    return str(sys._getframe(depth + 1).f_globals.get("__name__", ""))
