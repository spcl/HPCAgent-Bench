# GENERATED FROM the live EDF hpcagent-bench-vllm-mi300-latest.toml, then kept in the repo so a fresh clone can
# render its own. install_edfs.sh rewrites the `image` line; everything else here is the
# tuning that EDF already carried and must not drift.
# Replace both placeholders as described in containers/README.md before registering this EDF.
image = "${SCRATCH}/ce-images/PLACEHOLDER.sqsh"

mounts = [
  # install_edfs.sh replaces this item with hpcagent_bench_edf_mounts (scripts/cache_env.sh):
  # the filesystems of $SCRATCH and $FAST_SCRATCH.
  "<hpcagent_bench_edf_mounts>"
]

workdir = "${SCRATCH}"
# An in-image cache is only safe to name if a MISS has somewhere to go. Without this the
# squashfs is read-only and an op the prebuild did not cover fails outright instead of
# degrading to a cold build in the per-job CE overlay.
writable = true

[annotations]
# The CSCS-documented set. Three hooks, and we previously enabled only the middle one:
#   10-netstack.sh    source defaults to "artifact"; setting "host" makes it exit(0) and fall back
#                     to a raw filesystem graft -- which is how a host libcurl needing glibc 2.38
#                     reached an image with 2.35 and killed its whole OFI stack (629822).
#   89-libfabric-cxi  the cxi provider and /dev/cxi*.
#   90-aws-ofi-nccl   exits(0) unless enabled == "true". Never set until now, which is exactly why
#                     RCCL logged "NET/Plugin: Could not find: libnccl-net.so" and fell back to TCP
#                     over hsn* (629800/629802).
#
# With all three, job 629967 measured on an UNMODIFIED image: /opt/cscs/netstack/librccl-net.so,
# "Using network AWS Libfabric", GPU Direct RDMA on cxi0-2, 8 ranks over 2 nodes, correct result --
# that mount path is ARTIFACT mode's (container_netstack_path=/opt/cscs/netstack), not host mode's
# (/opt/cscs/aws-ofi-ccl-plugin/<variant>/lib*-net.so). "host" below was substituted for the
# 2026-09-17 /ritom migration, when /capstor/store did not exist, and 629967's proof line was kept
# without anyone re-running it against the substitute -- so host+rocm6 was never actually proven.
#
# It also cannot work on this image: variant=rocm6's plugin (/opt/cscs/aws-ofi-ccl-plugin/rocm6/
# librccl-net.so) needs libamdhip64.so.6 (`ldd`, confirmed 2026-09-18), and this image ships ROCm
# 7.2 (libamdhip64.so.7 only, no compat symlink -- major ROCm versions are not ABI-compatible).
# Every job that reached RCCL init under host+rocm6 logged the same two lines regardless of
# launcher (CE 640910, enroot 640950/641057/641172):
#   NET/Plugin: libamdhip64.so.6: cannot open shared object file: No such file or directory
#   NET/Plugin: Could not find: ofi.
# and fell back to Socket, or (with NCCL_NET forced below) hard-failed with "NCCL error: invalid
# usage ... Failed to initialize any NET plugin".
#
# /capstor/store/cscs/cscs/public/containers/netstack/x86_64/26.08.1/ is reachable again as of
# 2026-09-17 (confirmed 2026-09-18: contains the exact name below). Its plugin's RUNPATH is
# /opt/cscs/netstack -- the directory 10-netstack.sh mounts the whole bundle to in artifact mode --
# and the bundle carries its OWN libamdhip64.so.7 alongside librccl-net.so, so it needs nothing
# from the image's /opt/rocm at all. version/name are PINNED so a CSCS-side bump is a loud failure
# (scripts/cscs/netstack_preflight.sh), not a campaign that silently straddles two fabric stacks.
com.hooks.netstack.source = "artifact"
com.hooks.netstack.version = "26.08.1"
com.hooks.netstack.name = "gpu_rocm7-cxi_13.1.0-ofi_2.6.0-aws_1.20.0"
com.hooks.cxi.enabled = "true"
com.hooks.aws_ofi_nccl.enabled = "true"
# Ignored in artifact mode (only the host-mode case in 90-aws-ofi-nccl.sh reads it), kept so this
# EDF still says what it would need if source ever moves back to "host".
com.hooks.aws_ofi_nccl.variant = "rocm6"
[env]
# quark_online_quant is registered as a vllm general plugin, and load_general_plugins() runs it
# from `python -m vllm.model_executor.models.registry` -- a subprocess where vllm/__init__ is
# still executing. The plugin does `from vllm.engine.arg_utils import EngineArgs`, which reaches
# vllm/v1/sample/logits_processor/builtin.py doing `from vllm import SamplingParams`, closing a
# CIRCULAR IMPORT:
#   ImportError: cannot import name 'SamplingParams' from 'vllm' (unknown location)
# That killed all five oss120b arms (630706-630708, 630719, 630720). VLLM_PLUGINS is an ALLOWLIST
# and UNSET MEANS LOAD EVERYTHING, so quark is excluded by naming only what we want. oss120b is
# pre-quantized mxfp4 and never needs ONLINE quantization.
# It does NOT reproduce in a bare smoke -- 630756 served fine with plugins on -- because the
# campaign also sets aiter env, which changes the import graph enough to close the cycle.
# An ALLOWLIST, so naming the two LoRA resolvers excludes quark while keeping them. "" would
# also work but drops the resolvers for no reason. This is the ONLY owner of the setting: a
# campaign env exported under `set -a` that also set it could override the EDF and silently win.
VLLM_PLUGINS = "lora_filesystem_resolver,lora_hf_hub_resolver"
# CSCS documents this one against a hang at NCCL initialisation time.
HWLOC_COMPONENTS = "-gl"
FI_CXI_RX_MATCH_MODE = "software"
FI_MR_CACHE_MONITOR = "disabled"
HSA_ENABLE_IPC_MODE_LEGACY = "1"
SAFETENSORS_FAST_GPU = "1"
HIP_FORCE_DEV_KERNARG = "1"
TOKENIZERS_PARALLELISM = "false"

NCCL_NET_PLUGIN = "ofi"
NCCL_NET = "AWS Libfabric"
LD_LIBRARY_PATH = "/opt/rocm/lib:/opt/rocm/lib64"
FI_PROVIDER = "cxi"

NCCL_SOCKET_IFNAME = "hsn0,hsn1,hsn2,hsn3"
GLOO_SOCKET_IFNAME = "hsn0"

# Beverin's current kernel lacks the DMA-BUF options needed by this stack.
NCCL_DMABUF_ENABLE = "0"
OFI_NCCL_DISABLE_DMABUF = "1"

NCCL_DEBUG = "INFO"
NCCL_DEBUG_SUBSYS = "INIT,NET"

VIRTUAL_ENV = "/opt/pytorch211"
PATH = "/opt/pytorch211/bin:/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Needed at RUNTIME, not only when flash-attn was installed. flash_attn_interface.py:11 reads it
# at IMPORT: TRUE picks .flash_attn_triton_amd, FALSE imports flash_attn_2_cuda, the compiled CK
# extension a triton-only install does not have. vLLM wraps that import in try/except ImportError
# and just reports the backend unavailable -- the exact 589001 "No valid MLA prefill backend"
# failure, but with the package installed and looking fine.
FLASH_ATTENTION_TRITON_AMD_ENABLE = "TRUE"
# DECLARED, not inherited, for the same reason PATH is: the CE does not preserve the image's
# own ENV, so the Dockerfile's ENV AITER_JIT_DIR=/opt/aiter-jit never arrives and
# run_cluster.sh's ${AITER_JIT_DIR:-<scratch>} default wins -- which loads module_aiter_core
# from a HOST directory and leaves the image's prebuilt copy unused (measured, job 628077;
# declaring it moved the load to /opt/aiter-jit in 628103).
AITER_JIT_DIR = "/opt/aiter-jit"
# aiter's TEMPLATE ops ignore AITER_JIT_DIR and default to $HOME/.aiter -- the one host path
# the prebuild never closed. 628158 built three of them there at 77 s per serve. Pinned into
# the image, 628179 confirms nothing lands in HOME and the artefact hashes match.
AITER_ROOT_DIR = "/opt/aiter-root"
