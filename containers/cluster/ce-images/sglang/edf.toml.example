# EDF for the sglang image. install_edfs.sh rewrites the `image` line; everything else here is
# tuning that must not drift: SGLANG_USE_AITER=1, SGLANG_ROCM_FUSED_DECODE_MLA=0, TP<=4 (AITER
# MLA needs heads%16==0), --kv-cache-dtype fp8_e4m3, page_size 64 (avoids gfx942 page_size=1
# decode faults).
image = "${SCRATCH}/ce-images/PLACEHOLDER.sqsh"

mounts = [
  # install_edfs.sh replaces this item with hpcagent_bench_edf_mounts (scripts/cache_env.sh):
  # the filesystems of $SCRATCH and $FAST_SCRATCH.
  "<hpcagent_bench_edf_mounts>"
]

workdir = "${SCRATCH}"
# An in-image cache is only safe to name if a MISS has somewhere to go. Without this the
# squashfs is read-only and an op the prebuild did not cover fails outright instead of
# degrading to a cold build in the per-job CE overlay.
writable = true

[env]
# Against a hang at NCCL initialisation time.
HWLOC_COMPONENTS = "-gl"
FI_CXI_RX_MATCH_MODE = "software"
FI_MR_CACHE_MONITOR = "disabled"
HSA_ENABLE_IPC_MODE_LEGACY = "1"
SAFETENSORS_FAST_GPU = "1"
HIP_FORCE_DEV_KERNARG = "1"
TOKENIZERS_PARALLELISM = "false"
# DECLARED, not inherited, for the same reason PATH is: the CE does not preserve the image's
# own ENV, so without this run_cluster.sh's scratch default wins and the image's prebuilt
# module_aiter_core goes unused.
AITER_JIT_DIR = "/opt/aiter-jit"
# aiter's TEMPLATE ops ignore AITER_JIT_DIR and default to $HOME/.aiter -- the one host path
# the prebuild never closed. Pinned here so nothing lands in HOME instead.
AITER_ROOT_DIR = "/opt/aiter-root"

# libfabric and libcxi are NOT in the image -- the cxi hook supplies both, plus /dev/cxi*.
# Declaring LD_LIBRARY_PATH here is not optional: the CE does not preserve the image's own ENV,
# and omitting the plugin path silently returns RCCL to the TCP fallback.
LD_LIBRARY_PATH = "/opt/rocm/lib:/opt/rocm/lib64"

# The three that make RCCL take Slingshot rather than answer correctly over TCP. NCCL_NET_PLUGIN/
# NCCL_NET name the plugin the aws_ofi_nccl hook installs, so RCCL ERRORS when it is not loadable
# instead of silently falling back -- a fallback is numerically correct and several times slower,
# which is the failure mode that hides.
#
# FI_PROVIDER is safe HERE and is deliberately absent from the judge-agent EDFs: this image has
# no MPI, and MPICH inheriting the variable against a libfabric that cannot offer cxi is what
# aborts MPI_Init elsewhere.
NCCL_NET_PLUGIN = "ofi"
NCCL_NET = "AWS Libfabric"
FI_PROVIDER = "cxi"
NCCL_SOCKET_IFNAME = "hsn0,hsn1,hsn2,hsn3"
GLOO_SOCKET_IFNAME = "hsn0"

# Current kernel lacks the DMA-BUF options needed by this stack.
NCCL_DMABUF_ENABLE = "0"
OFI_NCCL_DISABLE_DMABUF = "1"

NCCL_DEBUG = "INFO"
NCCL_DEBUG_SUBSYS = "INIT,NET"

[annotations]
# Three hooks:
#   10-netstack.sh    source "artifact" mounts the pinned bundle; "host" falls back to a raw
#                     filesystem graft of the node's own stack.
#   89-libfabric-cxi  the cxi provider and /dev/cxi*.
#   90-aws-ofi-nccl   exits(0) unless enabled == "true".
#
# source="artifact" is required here: host mode's rocm6 plugin needs libamdhip64.so.6, which this
# ROCm 7.2 image does not ship (only libamdhip64.so.7, not ABI-compatible), so it cannot find the
# ofi plugin and falls back to Socket, or hard-fails once NCCL_NET is pinned below. The artifact
# bundle carries its own libamdhip64.so.7 alongside librccl-net.so, so it needs nothing from the
# image's /opt/rocm. version/name are PINNED so a CSCS-side bump is a loud failure
# (scripts/cscs/netstack_preflight.sh), not a campaign that silently straddles two fabric stacks.
com.hooks.netstack.source = "artifact"
com.hooks.netstack.version = "26.08.1"
com.hooks.netstack.name = "gpu_rocm7-cxi_13.1.0-ofi_2.6.0-aws_1.20.0"
com.hooks.cxi.enabled = "true"
com.hooks.aws_ofi_nccl.enabled = "true"
# Ignored in artifact mode; kept so this EDF still says what it would need if source ever moves
# back to "host".
com.hooks.aws_ofi_nccl.variant = "rocm6"
