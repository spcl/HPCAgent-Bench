# The AMD GPU arch of each beverin partition: the one table image builds, EDF renders and runtime
# checks read. Keys are GPU_ARCH_<Slurm partition>; values are the gfx agent name rocminfo reports.
#   mi300: AMD MI300A
#   mi200: AMD Instinct MI250X (rocminfo on nid002540)
GPU_ARCH_mi300=gfx942
GPU_ARCH_mi200=gfx90a
