# Judge web_search tool settings.

SERPAPI_API_KEY=
SERPAPI_URL=https://serpapi.com/search.json

# OpenAI/vLLM-compatible endpoint. The tool calls:
#   ${WEBSEARCH_LLM_BASE_URL}/chat/completions
WEBSEARCH_LLM_BASE_URL=http://127.0.0.1:8000/v1
WEBSEARCH_LLM_MODEL=
WEBSEARCH_LLM_API_KEY=

WEBSEARCH_TIMEOUT_SECONDS=60
WEBSEARCH_MAX_RESULTS=5
WEBSEARCH_MAX_PAGES=3
WEBSEARCH_MAX_CHARS_PER_PAGE=6000
WEBSEARCH_CRAWL_CONCURRENCY=3
WEBSEARCH_CHECK_ROBOTS_TXT=true
WEBSEARCH_PAGE_TIMEOUT_MS=30000
WEBSEARCH_BM25_THRESHOLD=1.0
WEBSEARCH_BM25_LANGUAGE=english
WEBSEARCH_LLM_MAX_TOKENS=4096
# Use max_completion_tokens for OpenAI models that reject max_tokens.
WEBSEARCH_LLM_TOKEN_FIELD=max_tokens
# Empty means omit temperature for maximum model compatibility.
WEBSEARCH_LLM_TEMPERATURE=
# GPT-5 reasoning models can spend the whole completion budget on invisible
# reasoning tokens if this is too high. Empty means omit.
WEBSEARCH_LLM_REASONING_EFFORT=minimal
WEBSEARCH_LLM_VERBOSITY=low
WEBSEARCH_LLM_EMPTY_RETRY_MULTIPLIER=4

# Test/development only: JSON object mapping URL to markdown/text content. When set,
# Crawl4AI is skipped and this mapping is used instead.
WEBSEARCH_FAKE_CRAWL_JSON=
