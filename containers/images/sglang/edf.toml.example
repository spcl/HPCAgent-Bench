# EDF template for hpcagent-bench-sglang-mi300-latest; install_edfs.sh renders it into ~/.edf and
# rewrites the `image` line. Everything else is serving tuning that must not drift.
# The image follows the official SGLang Kimi-K2.7-Code gfx942 recipe: SGLANG_USE_AITER=1
# SGLANG_ROCM_FUSED_DECODE_MLA=0, TP<=4 (AITER MLA needs heads%16==0), --kv-cache-dtype fp8_e4m3,
# page_size 64 (skips the gfx942 page_size=1 decode faults).
image = "${SCRATCH}/ce-images/PLACEHOLDER.sqsh"

mounts = [
  # install_edfs.sh replaces this item with hpcagent_bench_edf_mounts (scripts/cache_env.sh):
  # the filesystems of $SCRATCH and $FAST_SCRATCH.
  "<hpcagent_bench_edf_mounts>"
]

workdir = "${SCRATCH}"
# An in-image cache is only safe to name if a MISS has somewhere to go. Without this the
# squashfs is read-only and an op the prebuild did not cover fails outright instead of
# degrading to a cold build in the per-job CE overlay.
writable = true

[env]
# CSCS documents this one against a hang at NCCL initialisation time.
HWLOC_COMPONENTS = "-gl"
FI_CXI_RX_MATCH_MODE = "software"
FI_MR_CACHE_MONITOR = "disabled"
HSA_ENABLE_IPC_MODE_LEGACY = "1"
SAFETENSORS_FAST_GPU = "1"
HIP_FORCE_DEV_KERNARG = "1"
TOKENIZERS_PARALLELISM = "false"
# DECLARED, not inherited, for the same reason PATH is: the CE does not preserve the image's
# own ENV, so the Dockerfile's ENV AITER_JIT_DIR=/opt/aiter-jit never arrives and
# run_cluster.sh's ${AITER_JIT_DIR:-<scratch>} default wins -- which loads module_aiter_core
# from a HOST directory and leaves the image's prebuilt copy unused (measured).
AITER_JIT_DIR = "/opt/aiter-jit"
# aiter's TEMPLATE ops ignore AITER_JIT_DIR and default to $HOME/.aiter, where they build at 77 s
# per serve. Pinned into the image, nothing lands in HOME and the artefact hashes match.
AITER_ROOT_DIR = "/opt/aiter-root"

# The image is Ubuntu 24.04 (glibc 2.39), so the host Slingshot stack (built on 2.38) loads.
# libfabric, libcxi and the RCCL plugin are NOT in the image -- the netstack/cxi hooks supply them,
# plus /dev/cxi*. Declaring LD_LIBRARY_PATH here is not optional: the CE does not preserve the
# image's own ENV, so this file re-declares it absolutely.
LD_LIBRARY_PATH = "/opt/rocm/lib:/opt/rocm/lib64"

# The three that make RCCL take Slingshot rather than answer correctly over TCP, as in the vLLM
# EDF. NCCL_NET_PLUGIN/NCCL_NET name the plugin the aws_ofi_nccl hook installs, so RCCL ERRORS
# when it is not loadable instead of silently falling back -- a fallback is numerically correct
# and several times slower, which is the failure mode that hides.
#
# FI_PROVIDER is safe HERE and is deliberately absent from the judge-agent EDFs: this image has no
# MPI, while MPICH inherits the variable and aborts MPI_Init with "OFI call getinfo failed"
# against a libfabric that cannot offer cxi.
NCCL_NET_PLUGIN = "ofi"
NCCL_NET = "AWS Libfabric"
FI_PROVIDER = "cxi"
NCCL_SOCKET_IFNAME = "hsn0,hsn1,hsn2,hsn3"
GLOO_SOCKET_IFNAME = "hsn0"

# Beverin's current kernel lacks the DMA-BUF options needed by this stack.
NCCL_DMABUF_ENABLE = "0"
OFI_NCCL_DISABLE_DMABUF = "1"

NCCL_DEBUG = "INFO"
NCCL_DEBUG_SUBSYS = "INIT,NET"

[annotations]
# The CSCS-documented set; all three hooks are needed:
#   10-netstack.sh    source "artifact" mounts the netstack bundle at /opt/cscs/netstack. "host"
#                     makes it exit(0) and fall back to a raw filesystem graft of host libraries.
#   89-libfabric-cxi  the cxi provider and /dev/cxi*.
#   90-aws-ofi-nccl   exits(0) unless enabled == "true"; without it RCCL logs "NET/Plugin: Could
#                     not find: libnccl-net.so" and falls back to TCP over hsn*.
#
# With all three, measured on an UNMODIFIED image: /opt/cscs/netstack/librccl-net.so, "Using
# network AWS Libfabric", GPU Direct RDMA on cxi0-2, 8 ranks over 2 nodes, correct result.
#
# ARTIFACT, not host: host mode's variant=rocm6 plugin (/opt/cscs/aws-ofi-ccl-plugin/rocm6/
# librccl-net.so) needs libamdhip64.so.6, and this image ships ROCm 7.2 (libamdhip64.so.7 only,
# no compat symlink -- major ROCm versions are not ABI-compatible). Under host+rocm6 RCCL logs
#   NET/Plugin: libamdhip64.so.6: cannot open shared object file: No such file or directory
#   NET/Plugin: Could not find: ofi.
# and falls back to Socket, or (with NCCL_NET forced above) hard-fails with "NCCL error: invalid
# usage ... Failed to initialize any NET plugin".
#
# The artifact plugin's RUNPATH is /opt/cscs/netstack, and the bundle carries its OWN
# libamdhip64.so.7 alongside librccl-net.so, so it needs nothing from the image's /opt/rocm.
# version/name are PINNED so a campaign never silently straddles two fabric stacks.
com.hooks.netstack.source = "artifact"
com.hooks.netstack.version = "26.08.1"
com.hooks.netstack.name = "gpu_rocm7-cxi_13.1.0-ofi_2.6.0-aws_1.20.0"
com.hooks.cxi.enabled = "true"
com.hooks.aws_ofi_nccl.enabled = "true"
# Ignored in artifact mode (only the host-mode case in 90-aws-ofi-nccl.sh reads it), kept so this
# EDF still says what it would need if source ever moves back to "host".
com.hooks.aws_ofi_nccl.variant = "rocm6"
