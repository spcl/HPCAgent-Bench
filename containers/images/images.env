# The image registry: one row per image. Sourced by every build, verify, promote, pull, push and
# EDF script in this directory, and by experiments/ for the <PREFIX>_* names below.
#
# Consumers name the unversioned live squashfs / EDF; the .digest sidecar build.sh writes is the
# identity a results table cites. A build writes the candidate name, build_and_verify.sbatch (or
# the image's own build.sbatch) marks it .verified, and promote_image.sh renames it over the live
# name, so a running job never reads a half-written squashfs.
#
# Columns ('-' = none):
#   role       name the scripts take (promote_image.sh <role>, pull_image.sh <role>, ROLES=...)
#   prefix     derived variables <PREFIX>_SQSH, _EDF_LATEST, _TEMPLATE, _CANDIDATE, _TAG
#   platform   CE_PLATFORM that installs/promotes it: amd (beverin), gh200 (daint), cpu (any host)
#   dir        image directory under containers/images/ holding Dockerfile, build.sh, build.sbatch
#   partition  partition it is built on and whose GPU arch (gpu_arch.env) its EDF renders
#   profile    verify_image.py --profile
#   candidate  squashfs the build writes
#   sqsh       live squashfs under $CE_IMAGES
#   edf        EDF name install_edfs.sh renders into ~/.edf
#   template   EDF template, relative to containers/images/
#   tag        registry tag under REGISTRY_REPO (moving; push_image.sh adds sha-<digest>)
#   flags      opt = render only when the squashfs exists; preload=<lib> = append to LD_PRELOAD
#
# A registry tag is not an EDF name (tests/test_registry_tags_are_not_edf_names.py).
# SQSH and TAG take an environment override: INFERENCE_VLLM_SQSH=x.sqsh, JUDGE_AMD_RELEASE_TAG=...

REGISTRY_REPO="${REGISTRY_REPO:-docker.io/spcleth/hpcagent-bench}"
CE_ARCH="$(uname -m)"

CE_IMAGE_TABLE="$(cat <<EOF
judge-agent-amd       JUDGE_AGENT_AMD         amd   judge-agent-amd  mi300 judge-agent-amd  hpcagent-bench-ce-amd-mi300-candidate.sqsh       hpcagent-bench-agent-mi300.sqsh                   hpcagent-bench-agent-mi300-latest              judge-agent-amd/edf.toml.example        agent-mi300-latest -
judge                 JUDGE_AMD               amd   judge-agent-amd  mi300 judge            hpcagent-bench-ce-judge-amd-mi300-candidate.sqsh hpcagent-bench-judge-mi300.sqsh                   hpcagent-bench-judge-mi300-latest              judge-agent-amd/edf.judge.toml.example  judge-mi300-latest -
sglang                INFERENCE_SGLANG        amd   sglang           mi300 sglang           hpcagent-bench-sglang-candidate.sqsh             hpcagent-bench-sglang-mi300.sqsh                  hpcagent-bench-sglang-mi300-latest             sglang/edf.toml.example                 sglang-latest      -
vllm                  INFERENCE_VLLM          amd   vllm             mi300 vllm             hpcagent-bench-vllm-candidate.sqsh               hpcagent-bench-vllm-mi300.sqsh                    hpcagent-bench-vllm-mi300-latest               vllm/edf.toml.example                   vllm-latest        -
sglang-mi200          INFERENCE_SGLANG_MI200  amd   sglang-mi200     mi200 sglang-mi200     hpcagent-bench-sglang-mi200-candidate.sqsh       hpcagent-bench-sglang-mi200.sqsh                  hpcagent-bench-sglang-mi200-latest             sglang-mi200/edf.toml.example           -                  opt
judge-agent-amd-mi200 JUDGE_AGENT_AMD_MI200   amd   judge-agent-amd  mi200 judge-agent-amd  hpcagent-bench-ce-amd-mi200-candidate.sqsh       hpcagent-bench-agent-mi200.sqsh                   hpcagent-bench-agent-mi200-latest              judge-agent-amd/edf.toml.example        agent-mi200-latest opt
judge-mi200           JUDGE_AMD_MI200         amd   judge-agent-amd  mi200 judge            hpcagent-bench-ce-judge-amd-mi200-candidate.sqsh hpcagent-bench-judge-mi200.sqsh                   hpcagent-bench-judge-mi200-latest              judge-agent-amd/edf.judge.toml.example  judge-mi200-latest opt
judge-mi200-mlscale   JUDGE_AMD_MI200_MLSCALE amd   -                mi200 -                -                                                hpcagent-bench-judge-mi200.sqsh                   hpcagent-bench-judge-mi200-mlscale             judge-agent-amd/edf.judge.toml.example  -                  opt,preload=/usr/lib/x86_64-linux-gnu/libhwloc.so.15
judge-release         JUDGE_AMD_RELEASE       amd   judge-agent-amd  -     -                -                                                hpcagent-bench-judge-mi300-release-candidate.sqsh -                                              -                                       -                  -
judge-agent-cuda      JUDGE_AGENT_CUDA        gh200 judge-agent-cuda -     judge-agent-cuda hpcagent-bench-agent-gh200-candidate.sqsh        hpcagent-bench-agent-gh200.sqsh                   hpcagent-bench-agent-gh200-latest              judge-agent-cuda/edf.toml.example       agent-gh200-latest -
judge-cuda            JUDGE_CUDA              gh200 judge-agent-cuda -     judge-cuda       hpcagent-bench-judge-gh200-candidate.sqsh        hpcagent-bench-judge-gh200.sqsh                   hpcagent-bench-judge-gh200-latest              judge-agent-cuda/edf.judge.toml.example judge-gh200-latest -
vllm-cuda             INFERENCE_VLLM_CUDA     gh200 vllm-cuda        -     vllm-cuda        hpcagent-bench-vllm-gh200-candidate.sqsh         hpcagent-bench-vllm-gh200.sqsh                    hpcagent-bench-vllm-gh200-latest               vllm-cuda/edf.toml.example              -                  -
judge-agent-cpu       JUDGE_AGENT_CPU         cpu   judge-agent-cpu  -     judge-agent-cpu  hpcagent-bench-agent-cpu-${CE_ARCH}-candidate.sqsh hpcagent-bench-agent-cpu-${CE_ARCH}.sqsh      hpcagent-bench-agent-cpu-${CE_ARCH}-latest     judge-agent-cpu/edf.toml.example        -                  -
judge-cpu             JUDGE_CPU               cpu   judge-agent-cpu  -     judge-cpu        hpcagent-bench-judge-cpu-${CE_ARCH}-candidate.sqsh hpcagent-bench-judge-cpu-${CE_ARCH}.sqsh      hpcagent-bench-judge-cpu-${CE_ARCH}-latest     judge-agent-cpu/edf.judge.toml.example  -                  -
EOF
)"

# Exports <PREFIX>_SQSH/_EDF_LATEST/_TEMPLATE/_CANDIDATE for every row that has one, and <PREFIX>_TAG
# for every row (empty when unpublished).
ce_define_image_names() {
    local role prefix platform dir partition profile candidate sqsh edf template tag flags var
    while read -r role prefix platform dir partition profile candidate sqsh edf template tag flags; do
        [[ -n "${role}" ]] || continue
        var="${prefix}_SQSH"
        [[ "${sqsh}" == - ]] || printf -v "${var}" '%s' "${!var:-${sqsh}}"
        [[ "${edf}" == - ]] || printf -v "${prefix}_EDF_LATEST" '%s' "${edf}"
        [[ "${template}" == - ]] || printf -v "${prefix}_TEMPLATE" '%s' "${template}"
        [[ "${candidate}" == - ]] || printf -v "${prefix}_CANDIDATE" '%s' "${candidate}"
        var="${prefix}_TAG"
        [[ "${tag}" == - ]] && tag=""
        printf -v "${var}" '%s' "${!var:-${tag}}"
    done <<<"${CE_IMAGE_TABLE}"
}
ce_define_image_names

# Prints the roles of a platform (every role when none is given), in table order.
ce_roles() {
    awk -v p="${1:-}" 'NF && (p == "" || $3 == p) {print $1}' <<<"${CE_IMAGE_TABLE}"
}

# ce_image <role> <column>: one column of a role's row, with the SQSH/TAG environment override
# applied. Exit 2 for an unknown role or a '-' cell.
ce_image() {
    local row prefix value var
    row="$(awk -v r="$1" '$1 == r' <<<"${CE_IMAGE_TABLE}")"
    [[ -n "${row}" ]] || { echo "images.env has no role '$1'" >&2; return 2; }
    read -r _ prefix _ <<<"${row}"
    case "$2" in
        sqsh) var="${prefix}_SQSH"; value="${!var:-}" ;;
        tag)  var="${prefix}_TAG";  value="${!var:-}" ;;
        role|prefix|platform|dir|partition|profile|candidate|edf|template|flags)
            local -A col=([role]=1 [prefix]=2 [platform]=3 [dir]=4 [partition]=5 [profile]=6 [candidate]=7
                          [sqsh]=8 [edf]=9 [template]=10 [tag]=11 [flags]=12)
            value="$(awk -v c="${col[$2]}" '{print $c}' <<<"${row}")" ;;
        *) echo "ce_image: unknown column '$2'" >&2; return 2 ;;
    esac
    [[ -n "${value}" && "${value}" != - ]] || return 2
    printf '%s\n' "${value}"
}

# ce_require_partition <role>: refuse a build job that landed on another partition than its row
# names. The partition comes from SBATCH_PARTITION (site layer) or the command line, and a job on
# the wrong one would build the image for the wrong GPU arch without any error.
ce_require_partition() {
    local want
    want="$(ce_image "$1" partition)" || return 2
    if [[ -n "${SLURM_JOB_PARTITION:-}" && "${SLURM_JOB_PARTITION}" != "${want}" ]]; then
        echo "$1 builds on partition ${want}, this job runs on ${SLURM_JOB_PARTITION}: resubmit with -p ${want}" >&2
        return 2
    fi
}
