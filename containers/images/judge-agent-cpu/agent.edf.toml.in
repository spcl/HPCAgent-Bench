# CSCS Container Engine EDF for the AGENT target of judge-agent-cpu/Dockerfile, either architecture.
# `CE_PLATFORM=cpu install_edfs.sh` renders it into ~/.edf as hpcagent-bench-agent-cpu-<arch>-latest.
#
# PATH is the image's own ENV (the CE reads its /etc/environment) with the launch venv in front.
# /usr/local/bin is the symlinks onto /opt/gcc, spack's gcc 16.2.0 (ahead of distro gcc 13), /usr/lib/llvm-22/bin clang/flang;
# keep in sync with the Dockerfile's GCC_VERSION / LLVM_MAJOR.
#
# On Slingshot the cxi hook and the FI_CXI_* settings below are the GPU EDFs' (judge-agent-cuda). A multi-node
# grade reaches cxi: Daint job 5430088 (2 nodes, the image of build 5429444) ran on provider cxi with this EDF and
# without the hook and the FI_CXI_* settings. See IMAGE_REQUIREMENTS.md, Fabric.
image = "${SCRATCH}/ce-images/hpcagent-bench-agent-cpu.sqsh"
mounts = [
    # install_edfs.sh replaces this item with hpcagent_bench_edf_mounts (helpers/scripts/cache_env.sh):
    # the filesystems of $SCRATCH and $FAST_SCRATCH.
    "<hpcagent_bench_edf_mounts>",
    "${SCRATCH}:${SCRATCH}",
    # The node's /dev/shm with exec (the CE mounts the container's own noexec): the launch venv's home.
    "/dev/shm:/opt/node-shm",
]
workdir = "${SCRATCH}"
writable = true
# The image's ENTRYPOINT is the launch hook (containers/images/lib/launch_venv.sh): it puts the node's venv of the locked
# wheel packages in front of the image's PATH and names its python in HPCAGENT_BENCH_IMAGE_PYTHON. The CE applies
# [env] after the ENTRYPOINT, so [env] never sets PATH, VIRTUAL_ENV or HPCAGENT_BENCH_IMAGE_PYTHON: PATH is the
# image's ENV (its /etc/environment), which the image's build gates check (tests/test_edf_contract.py).
entrypoint = true

[env]
LC_ALL = "C"
# Image's dace must win over a same-named directory in the workdir.
PYTHONSAFEPATH = "1"
# The spack MPI stack (Dockerfile step 1c): the CE drops the image ENV that names it.
LD_LIBRARY_PATH = "/opt/gcc/lib64:/opt/gcc/lib:/opt/view/lib"
# Named, not left to PATH: a stale configure cache beats PATH.
CC = "/opt/gcc/bin/gcc"
CXX = "/opt/gcc/bin/g++"
FC = "/opt/gcc/bin/gfortran"
DACE_compiler_cpu_executable = "/opt/gcc/bin/g++"
# The hwloc GPU probe hangs a containerized MPI launcher.
HWLOC_COMPONENTS = "-opencl,-levelzero,-gl"
# hwloc preloaded with MPI: MPICH resolves libhwloc.so.15 to this PCI-capable one (mpi_gpu_check.sh 1a).
LD_PRELOAD = "/usr/local/lib/libmimalloc.so:/usr/lib/${MULTIARCH}/libhwloc.so.15"
# CSCS's Slingshot settings, as judge-agent-cuda. FI_MR_CACHE_MONITOR is left to libfabric: AMD and CUDA set it per
# platform (disabled, userfaultfd), and this EDF serves both architectures.
FI_CXI_RX_MATCH_MODE = "software"
FI_CXI_DEFAULT_CQ_SIZE = "131072"
FI_CXI_DEFAULT_TX_SIZE = "16384"
FI_CXI_DISABLE_HOST_REGISTER = "1"

[annotations]
com.hooks.cxi.enabled = "true"
