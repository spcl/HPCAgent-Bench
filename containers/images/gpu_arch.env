# GPU architectures, the one table image builds, EDF renders and runtime checks read.
#
# GPU_ARCH_<Slurm partition>: the gfx agent name rocminfo reports on that partition's nodes. An EDF
# renders it (the arch a JIT compiles for at run time) and gpu_arch_check.sh requires it to be one
# of the image's targets.
#   mi300: AMD MI300A
#   mi200: AMD Instinct MI250X
GPU_ARCH_mi300=gfx942
GPU_ARCH_mi200=gfx90a
#
# The targets a portable AMD image carries device code for: every arch the base image's vendor
# libraries support, so one image runs on any of them. MI400 (gfx1250) joins when a ROCm base ships
# libraries for it; ROCm 7.2 does not.
#   AMD:    MI250X, MI300A/X, MI355X
AMD_GPU_TARGETS=gfx90a;gfx942;gfx950
