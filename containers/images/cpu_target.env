# The spack CPU target each beverin partition's image build pins, beside gpu_arch.env's GPU arch.
# Keys are SPACK_TARGET_<Slurm partition>; values are spack microarchitecture names.
#   mi200: AMD EPYC 7A53, Zen 3, no AVX-512 (also the login nodes)
# mi300 has no row: its images keep spack's host detection, zen4 on the MI300A build node. A zen4
# image dies on SIGILL on Zen 3 at container start (the preloaded mimalloc), so an mi200 image pins
# its target and concretization fails on a node that cannot honour it.
SPACK_TARGET_mi200=zen3
