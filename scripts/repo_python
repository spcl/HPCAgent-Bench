#!/usr/bin/env bash
# python3 with this checkout on its import path (scripts/repo_env.sh), for a command that starts
# inside a container, where no shell of ours has sourced repo_env.sh yet:
#
#   srun --environment=... "${REPO}/scripts/repo_python" script.py args...
#
# REPO_PYTHON picks another interpreter (default: python3 on PATH).

# A core dump lands in the crashing process's CWD (the checkout) and Slurm propagates the
# SUBMITTER's core limit, so the floor has to be set here.
ulimit -c 0
. "$(dirname -- "${BASH_SOURCE[0]}")/repo_env.sh"
exec "${REPO_PYTHON:-python3}" "$@"
