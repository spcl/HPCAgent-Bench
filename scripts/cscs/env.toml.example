# CSCS Alps Container Engine (EDF) template for an HPCAgent-Bench run.
# Copy to env.toml, fill in the image + scratch paths, then:
#   EDF=scripts/cscs/env.toml sbatch -A <account> scripts/submit_launch.sbatch
#
# On Alps every `srun` must carry `--environment=<this file>` or it runs outside the image.
#
# Two things bite here:
#  * Compute nodes are GH200 quads -> aarch64. An x86_64 image will NOT run. Build off-cluster
#    (podman / docker buildx --platform linux/arm64) and `enroot import` to a SquashFS on scratch.
#  * `-A <account>` is mandatory (or export SBATCH_ACCOUNT before sbatch).
#
# One EDF covers the whole allocation: `vllm serve` is a subprocess of the launcher rank
# (cluster_launch.py), so it inherits this container rather than needing its own.

# OCI reference OR an absolute SquashFS path on scratch (the sqsh path is the reliable one).
image = "${SCRATCH}/ce-images/hpcagent_bench-aarch64.sqsh"

mounts = [
    "/capstor",
    "/iopsstor",
    "${HPCAGENT_BENCH_REPO}:${HPCAGENT_BENCH_REPO}",
]
workdir = "${HPCAGENT_BENCH_REPO}"
writable = true

[annotations]
# Routes NCCL over libfabric/CXI so multi-node vLLM uses Slingshot instead of falling back to
# TCP. Harmless single-node; required the moment NODES_PER_VLLM > 1.
com.hooks.aws_ofi_nccl.enabled = "true"
com.hooks.aws_ofi_nccl.variant = "cuda12"

[env]
# HF cache on scratch, never the home quota (models are tens of GB).
HF_HOME = "${SCRATCH}/huggingface"
# NCCL watchdog surfaces a hang as an exception instead of stalling the allocation.
TORCH_NCCL_ASYNC_ERROR_HANDLING = "1"
# MPICH GPU support off: it deadlocks against NCCL when both are live in one step.
MPICH_GPU_SUPPORT_ENABLED = "0"
CUDA_CACHE_DISABLE = "1"
# hwloc GPU-probe plugins hang the topology probe in some sandboxes (docs/runtime.md).
HWLOC_COMPONENTS = "-opencl,-levelzero,-gl"
# vLLM symmetric-memory paths are not reliable on aarch64/GH200; disable both.
VLLM_ALLREDUCE_USE_SYMM_MEM = "0"
VLLM_NCCL_USE_SYMM_MEM = "0"
