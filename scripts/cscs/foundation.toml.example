# CSCS Alps Container Engine (EDF) template for the FOUNDATION-track deterministic sweep.
#
# The foundation track is the compiler-optimization corpus: TSVC-derived kernels run through
# deterministic optimizers (no model in the loop, no vLLM, no judge). So this EDF is the
# smaller sibling of env.toml.example -- same image, none of the inference plumbing.
#
#   cp scripts/cscs/foundation.toml.example $SCRATCH/foundation.toml   # then edit `image`
#   EDF=$SCRATCH/foundation.toml sbatch -A <account> scripts/cscs/submit_foundation_alps.sbatch
#
# On Alps every `srun` must carry `--environment=<this file>` or the step runs outside the image.
#
# THE IMAGE IS OCI, and the container engine converts it ITSELF. A registry reference in the
# `image` field below is pulled, converted to SquashFS and cached by CE -- there is no manual
# import step. Pre-importing to a .sqsh on scratch is an optimisation that skips the per-job
# pull, not a requirement (see the header of submit_foundation_alps.sbatch).
#
# Compute nodes are GH200 quads, i.e. aarch64. One TAG can serve both architectures if it is a
# multi-arch manifest list (`docker buildx build --platform linux/amd64,linux/arm64 --push`);
# an amd64-only image fails at exec time inside the first step, not at submission.

# EITHER a registry reference, in the engine's `[REGISTRY#]IMAGE[:TAG]` form:
#   image = "quay.io#spcl/hpcagent_bench:cpu"
# OR an absolute SquashFS path on scratch, when a pre-import is worth the setup:
image = "${SCRATCH}/ce-images/hpcagent_bench-aarch64.sqsh"

mounts = [
    "/capstor",
    "/iopsstor",
    "${HPCAGENT_BENCH_REPO}:${HPCAGENT_BENCH_REPO}",
]
workdir = "${HPCAGENT_BENCH_REPO}"
writable = true

# HOOKS are where the Alps container engine earns its keep. The engine is podman underneath, with
# a SquashFS layer format and a set of pre-defined OCI hooks that wire the container to the Cray
# fabric and GPU stack. The image does NOT carry them: they are enabled per-EDF, here.
#
# This foundation sweep needs NONE, and that is a deliberate statement rather than an omission:
# every rank runs a single-node shard and the ranks never talk to each other (the shard index
# comes from SLURM_PROCID, not MPI), so there is no rank-to-rank traffic to accelerate.
#
# The MPI / distributed track is the opposite case. Enable the fabric hook there, or the ranks
# silently fall back to TCP over the management network and the result reads as poor scaling
# rather than as a misconfigured launch:
#
#   [annotations]
#   com.hooks.aws_ofi_nccl.enabled = "true"
#   com.hooks.aws_ofi_nccl.variant = "cuda12"

[env]
# hwloc's GL/OpenCL probes open a display and hang the topology probe inside a container; a dace
# import pulls mpi4py transitively and stalls before running a line (docs/runtime.md).
HWLOC_COMPONENTS = "-opencl,-levelzero,-gl"
UCX_VFS_ENABLE = "n"
# The foundation sweep is single-node per rank and the ranks never talk to each other (the shard
# index comes from SLURM_PROCID, not MPI), so MPICH's GPU support is dead weight here.
MPICH_GPU_SUPPORT_ENABLED = "0"
CUDA_CACHE_DISABLE = "1"
